{
  "name": "aether",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node qa/bundle-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src index.html vite.config.ts qa/*.mjs",
    "qa": "node qa/qa.mjs",
    "qa:geometry": "node --experimental-strip-types qa/geometry-check.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "postprocessing": "6.39.6",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "simplex-noise": "4.0.3",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "@types/three": "0.187.0",
    "lil-gui": "0.21.0",
    "playwright": "1.64.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "@types/node": "26.6.6",
    "pngjs": "7.0.0"
  },
  "overrides": {
    "three": "0.187.0"
  }
}