#include <sdf>
#include <atmosphere>
uniform vec3 uSun;uniform int uSteps;uniform float uFade;varying vec3 vWorld;
void main(){vec3 ro=cameraPosition,rd=normalize(vWorld-ro);vec2 hit=sphereHit(ro,rd,10.9);if(hit.y<0.)discard;float begin=max(hit.x,0.),end=hit.y;vec2 ground=sphereHit(ro,rd,10.);if(ground.x>0.)end=min(end,ground.x);float stepSize=(end-begin)/float(uSteps);vec3 beta=vec3(.0058,.0135,.0331)*7.;float mie=.021*3.;float odR=0.,odM=0.;vec3 sumR=vec3(0.),sumM=vec3(0.);for(int i=0;i<24;i++){if(i>=uSteps)break;vec3 p=ro+rd*(begin+(float(i)+.5)*stepSize);float height=max(length(p)-10.,0.);float rhoR=exp(-height/.225),rhoM=exp(-height/.09);odR+=rhoR*stepSize;odM+=rhoM*stepSize;vec2 lightHit=sphereHit(p,uSun,10.9);float lstep=max(lightHit.y,0.)/4.;float lightR=0.,lightM=0.;for(int j=0;j<4;j++){float lh=max(length(p+uSun*(float(j)+.5)*lstep)-10.,0.);lightR+=exp(-lh/.225)*lstep;lightM+=exp(-lh/.09)*lstep;}vec3 attenuation=exp(-(beta*(odR+lightR)+mie*(odM+lightM)));float sunlit=smoothstep(-.12,.06,dot(normalize(p),uSun));sumR+=attenuation*rhoR*stepSize*sunlit;sumM+=attenuation*rhoM*stepSize*sunlit;}float mu=dot(rd,uSun);vec3 color=(sumR*beta*phaseRayleigh(mu)+sumM*mie*phaseMie(mu,.76))*22.;vec3 n=normalize(vWorld);float edge=pow(1.-max(dot(n,-rd),0.),3.);float dusk=exp(-abs(dot(n,uSun))*14.);color+=vec3(.48,.055,.018)*dusk*edge*.36; color+=vec3(.006,.014,.025)*edge;gl_FragColor=vec4(color*uFade,1.);}