#include <terrain>
uniform vec3 uSun;uniform float uTime;uniform float uFade;uniform int uOctaves;varying vec3 vP;varying vec3 vWorld;varying vec3 vNormal;void main(){vec3 n=normalize(vP);float density=cloudDensity(n,uTime);float detail=noise3(n*75.+uTime*.008);float alpha=smoothstep(.47,.68,density)*(.75+.25*detail);float light=dot(normalize(vNormal),uSun);float day=max((light+.25)/1.25,0.);vec3 col=mix(vec3(.006,.009,.025),vec3(.8,.85,.9),day);float dusk=exp(-abs(light)*12.);col+=vec3(.6,.12,.035)*dusk*.4;float flash=exp(-dot(n-normalize(vec3(sin(floor(uTime/6.3)*1.7),.4,cos(floor(uTime/6.3)*1.7))),n-normalize(vec3(sin(floor(uTime/6.3)*1.7),.4,cos(floor(uTime/6.3)*1.7))))*800.)*step(.981,fract(uTime/6.3))*step(light,0.);col+=vec3(.7,2.,3.)*flash;gl_FragColor=vec4(col,alpha*.91*uFade);}