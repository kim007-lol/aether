precision highp sampler3D;
#include <sdf>
#include <atmosphere>
uniform sampler3D uNoise;uniform mat4 uInverseProjection;uniform mat4 uCameraWorld;uniform vec3 uCamera;uniform int uSteps;uniform float uTime;uniform float uFade;varying vec2 vUv;
float ellipsoid(vec3 p,vec3 c,vec3 r){vec3 q=(p-c)/r;return exp(-dot(q,q)*2.);}
float density(vec3 p){vec3 q=p+vec3(uTime*.035,0.,uTime*.018);float n1=texture(uNoise,q*.012).r,n2=texture(uNoise,q*.03+vec3(.3,.7,.5)).r,n3=texture(uNoise,q*.07+.6).r;float lobe=max(ellipsoid(p,vec3(155.,5.,-210.),vec3(60.,34.,65.)),max(ellipsoid(p,vec3(205.,22.,-267.),vec3(55.,55.,60.)),ellipsoid(p,vec3(135.,-23.,-285.),vec3(62.,35.,52.))));float falloff=1.-smoothstep(115.,140.,length(p-vec3(170.,15.,-250.)));return pow(max((n1*.55+n2*.3+n3*.15-.29)*2.6,0.),1.8)*lobe*falloff;}
vec3 colorRamp(float d){vec3 cyan=vec3(.107,.753,1.),violet=vec3(.259,.107,1.),ember=vec3(1.,.255,.072);return mix(mix(cyan,violet,smoothstep(.15,.5,d)),ember,smoothstep(.5,.85,d));}
void main(){vec4 view=uInverseProjection*vec4(vUv*2.-1.,1.,1.);vec3 rd=normalize(mat3(uCameraWorld)*view.xyz);vec2 hit=sphereHit(uCamera-vec3(170.,15.,-250.),rd,140.);if(hit.y<0.){gl_FragColor=vec4(0.,0.,0.,1.);return;}float start=max(hit.x,0.),stepSize=clamp((hit.y-start)/float(uSteps),1.,2.5);float jitter=fract(52.9829189*fract(dot(gl_FragCoord.xy,vec2(.06711056,.00583715))));float transmittance=1.;vec3 light=vec3(0.);for(int i=0;i<112;i++){if(i>=uSteps||transmittance<.02)break;float distance=start+(float(i)+jitter)*stepSize;if(distance>hit.y)break;vec3 p=uCamera+rd*distance;float d=density(p);vec3 illumination=vec3(.2,.24,.4);vec3 delta=vec3(175.,18.,-230.)-p;float shadow=exp(-density(p+normalize(delta)*4.)*2.);illumination+=vec3(.6,.85,1.)*3./(1.+dot(delta,delta)*.005)*shadow;delta=vec3(205.,-5.,-265.)-p;illumination+=vec3(1.,.3,.09)*4./(1.+dot(delta,delta)*.006);delta=vec3(145.,25.,-270.)-p;illumination+=vec3(.25,.35,1.)*3./(1.+dot(delta,delta)*.004);delta=vec3(160.,-12.,-195.)-p;illumination+=vec3(.2,.9,1.)*2./(1.+dot(delta,delta)*.007);delta=vec3(200.,35.,-300.)-p;illumination+=vec3(1.,.5,.2)*3./(1.+dot(delta,delta)*.004);float absorption=1.-exp(-d*.06*stepSize);light+=transmittance*absorption*colorRamp(d)*illumination*1.8;transmittance*=1.-absorption;}gl_FragColor=vec4(light*uFade,mix(1.,transmittance,uFade));}