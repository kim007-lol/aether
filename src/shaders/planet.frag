#include <terrain>
#include <rings>
uniform vec3 uSun;uniform float uTime;uniform float uFade;varying vec3 vP;varying vec3 vWorld;varying vec3 vNormal;
void main(){vec3 n=normalize(vP);float h=terrain(n);float land=smoothstep(.477,.50,h);float lat=abs(n.y);float moisture=fbm(n*8.+15.);vec3 ocean=mix(vec3(.0012,.013,.037),vec3(.005,.086,.13),smoothstep(.35,.48,h));ocean=mix(ocean,vec3(.015,.32,.3),smoothstep(.455,.482,h)*.6);vec3 biome=mix(vec3(.24,.16,.066),vec3(.026,.085,.032),smoothstep(.3,.65,moisture));biome=mix(vec3(.55,.45,.24),biome,smoothstep(.487,.51,h));biome=mix(biome,vec3(.15,.13,.11),smoothstep(.59,.67,h));biome=mix(biome,vec3(.78,.85,.9),smoothstep(.68,.72,h));vec3 albedo=mix(ocean,biome,land);float ice=smoothstep(.78+noise3(n*16.)*.06,.87,lat);albedo=mix(albedo,vec3(.68,.81,.87),ice);vec3 tangent=normalize(cross(n,vec3(.001,1.,.001)));vec3 bitangent=cross(n,tangent);float d1=terrain(normalize(n+tangent*.002))-h;float d2=terrain(normalize(n+bitangent*.002))-h;vec3 N=normalize(vNormal-(tangent*d1+bitangent*d2)*land*19.);vec3 V=normalize(cameraPosition-vWorld);float ndl=dot(N,uSun);float daylight=max((ndl+.15)/1.15,0.);vec3 ringN=normalize(vec3(.115,.954,.276));float planeDenom=dot(uSun,ringN);float rayDistance=-dot(vWorld,ringN)/planeDenom;vec3 ringHit=vWorld+uSun*rayDistance;float ringShadow=rayDistance>0.?1.-.5*ringDensity(length(ringHit)):1.;float clouds=smoothstep(.47,.68,cloudDensity(n-uSun*.02,uTime));vec3 lit=albedo*(daylight*1.8*(1.-clouds*.55)*ringShadow+vec3(.009,.014,.022));vec3 H=normalize(V+uSun);float ndh=max(dot(N,H),0.);float rough=.08,alpha=rough*rough;float distribution=alpha*alpha/(3.14159*pow(max(ndh*ndh*(alpha*alpha-1.)+1.,.0001),2.));float fresnel=.02+.98*pow(1.-max(dot(V,H),0.),5.);float wave=.85+.15*noise3(n*130.+uTime*.06);lit+=min(distribution*fresnel*.07,1.5)*max(ndl,0.)*(1.-land)*wave*vec3(1.,.8,.52);float night=1.-smoothstep(-.05,.2,ndl);float urban=pow(noise3(n*37.+8.),4.);float grid=step(.77,noise3(n*230.))*smoothstep(.12,.28,urban)*smoothstep(.49,.53,h)*(1.-smoothstep(.6,.67,h));vec3 city=mix(vec3(1.,.22,.035),vec3(1.,.68,.27),noise3(n*190.));lit+=city*grid*night*2.2*(.95+.05*sin(uTime*.7+n.x*73.));float rim=pow(1.-max(dot(V,N),0.),4.);lit+=vec3(.004,.019,.035)*rim;gl_FragColor=vec4(lit,uFade);}