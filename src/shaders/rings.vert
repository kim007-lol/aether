attribute vec4 aOrbit;uniform float uTime;uniform float uPixelRatio;uniform float uFade;varying vec3 vWorld;varying float vRadius;varying float vFade;varying float vSeed;void main(){float r=aOrbit.x;float theta=aOrbit.y+uTime*.25*pow(r/14.,-1.5);vec3 p=vec3(cos(theta)*r,aOrbit.z,sin(theta)*r);vec4 world=modelMatrix*vec4(p,1.);vec4 mv=viewMatrix*world;gl_Position=projectionMatrix*mv;float distance=length(world.xyz-cameraPosition);gl_PointSize=clamp(aOrbit.w*250.*uPixelRatio/max(-mv.z,.1),1.5,22.);vRadius=r;vWorld=world.xyz;vFade=smoothstep(1.5,3.,distance)*uFade;vSeed=aOrbit.w;}